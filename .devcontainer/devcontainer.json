// Dev container for dp-code. Format: https://aka.ms/devcontainer.json
//
// It reuses ../docker/Dockerfile with the repository root as the build context,
// so it inherits both the .dockerignore added there (without which this build
// ships a 327 GB context) and that file's honest status: the image has never
// been verified to build.
//
// THREE THINGS TO KNOW BEFORE USING IT
//
//  1. The four host paths below are the FIIT cluster's layout. They are
//     unchanged, because changing them would break the machine this project
//     actually runs on — but they will not exist on yours. Edit them, or use
//     docker/run.sh instead, which takes DP_HOST_DATASETS / DP_HOST_SCRATCH /
//     DP_HOST_NFS from the environment.
//  2. `postCreateCommand` runs `pip install -e . --no-deps`, and it is load
//     bearing rather than convenience: the image no longer sets PYTHONPATH, so
//     the editable install is what makes `import project.survival` resolve and
//     what puts dp-train, dp-evaluate, dp-analysis, dp-data, dp-cptac and
//     dp-config on PATH. `--no-deps` because the image already carries the pins.
//  3. `--shm-size 24g` here versus `8g` in docker/run.sh. Left as it is: torch
//     DataLoader workers (num_workers is hardcoded to 4 in CLAM) share memory
//     through /dev/shm, and lowering it to match would be a behaviour change.
{
	"name": "dp-code",
	// Sets the run context to one level up instead of the .devcontainer folder.
	"context": "..",
	"dockerFile": "../docker/Dockerfile",
	// `settings` and `extensions` at the top level were deprecated in favour of
	// `customizations.vscode` (they still work, but are schema-legacy from the
	// 2022 dev-containers template this file started as).
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/opt/venv/bin/python"
			},
			"extensions": [
				"wayou.vscode-icons-mac",
				"ms-toolsai.jupyter",
				"ms-python.python",
				"GitLab.gitlab-workflow"
			]
		}
	},
	"runArgs": [
		"--gpus",
		"all",
		"--privileged",
		"--network=bridge",
		"--shm-size",
		"24g",
		"-e",
		"CUDA_VISIBLE_DEVICES=0",
		// Volumes — cluster-specific, see note 1 above.
		"-v",
		"/mnt/scratch/${localEnv:USER}/.datasets:/mnt/datasets",
		"-v",
		"/mnt/nfs-data:/mnt/nfs-data",
		"-v",
		"/mnt/scratch/${localEnv:USER}/.datasets:/workspace/${localWorkspaceFolderBasename}/.datasets",
		"-v",
		"/mnt/scratch/${localEnv:USER}/${localWorkspaceFolderBasename}:/workspace/${localWorkspaceFolderBasename}/.scratch",
		// The W&B API key. Mounted from the host, never baked into the image.
		"-v",
		"${localEnv:HOME}/.netrc:/root/.netrc"
	],
	"mounts": [
		// Git & Other credentials
		"source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly"
	],
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind",
	"workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
	// See note 2. Run once, after the bind mount exists.
	"postCreateCommand": "pip install -e . --no-deps"
}
